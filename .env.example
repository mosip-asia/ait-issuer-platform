# ==============================================================================
# AIT Multi-Credential Verifiable Credential Platform
# Root Developer Environment Configuration
# ==============================================================================
# Copy to .env:
#   cp .env.example .env
#   docker compose up -d --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Compose Configuration & Development Mode
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=vc-stack
COMPOSE_FILE=compose.database.yaml:compose.certify.yaml
INSTALLATION=ait
IMAGE_TAG=latest
#
# Modular Composes:
# - Core Issuer:    compose.database.yaml:compose.certify.yaml (or compose.yaml)
# - Verifier:       compose.database.yaml:compose.verify.yaml
# - Web Wallet:     compose.web-wallet.yaml
# - Ingress (HTTP): compose.traefik.yaml
# - Ingress (TLS):  compose.traefik.yaml:compose.traefik-tls.yaml
# - Trust Stack:    compose.trust.yaml (VDR Contexts & VCGA Metadata)
# - Mock Stack:     compose.mock.yaml (Keycloak, mock Adapter)
#
# Full Local Stack:
# COMPOSE_FILE=compose.yaml:compose.mock.yaml

# ------------------------------------------------------------------------------
# 1. Ingress & Port Configuration
# ------------------------------------------------------------------------------
# Institutional Production Domains (*.dpi.ait.ac.th):
# - Issuer Engine:  https://issuer.dpi.ait.ac.th
# - Verifier UI:    https://verifier.dpi.ait.ac.th (or https://verifer.dpi.ait.ac.th)
# - Web Wallet:     https://wallet.dpi.ait.ac.th
# - VDR (Registry):   https://vdr.dpi.ait.ac.th
# - VCGA (Catalog):   https://vcga.dpi.ait.ac.th

# Traefik Edge Ingress Host Ports (Eliminates port memorization via *.localhost)
TRAEFIK_WEB_PORT=80
TRAEFIK_WEBSECURE_PORT=443
TRAEFIK_DASHBOARD_PORT=8088
ACME_EMAIL=admin@dpi.ait.ac.th

# Traefik Edge Ingress Host Routing Rules (Customizable per environment)
# - Local (HTTP): Host(`issuer.localhost`), Host(`verifier.localhost`), Host(`wallet.localhost`)
# - Remote (TLS): Host(`issuer-dev.ait-vc.dpi.ait.ac.th`), Host(`verifier-dev.ait-vc.dpi.ait.ac.th`), etc.
# Note: When using Let's Encrypt (compose.traefik-tls.yaml), rules must specify ONLY public FQDNs.
# Never include *.localhost alongside public FQDNs, or Let's Encrypt ACME orders will be rejected.
TRAEFIK_CERTIFY_RULE=Host(`issuer.localhost`)
TRAEFIK_VERIFY_RULE=Host(`verifier.localhost`)
TRAEFIK_WALLET_RULE=Host(`wallet.localhost`)
TRAEFIK_VDR_RULE=Host(`vdr.localhost`)
TRAEFIK_VCGA_RULE=Host(`vcga.localhost`)
TRAEFIK_VCLAB_RULE=Host(`lab.localhost`)
TRAEFIK_DASHBOARD_RULE=Host(`traefik.localhost`)

# Local Domain Ingress Base URLs (*.localhost)
CERTIFY_PUBLIC_BASE_URL=http://issuer.localhost
INJI_WEB_URL=http://wallet.localhost
INJI_VERIFY_URL=http://verifier.localhost
KEYCLOAK_PUBLIC_BASE_URL=http://auth.localhost
VDR_BASE_URL=http://vdr.localhost
VCGA_BASE_URL=http://vcga.localhost
TRUSTED_VCGA_URLS=http://vcga.localhost,https://vcga.dpi.ait.ac.th

# ------------------------------------------------------------------------------
# 2. Cryptographic Identity & Keystore (IMMUTABLE ONCE ISSUANCE BEGINS)
# ------------------------------------------------------------------------------
# ⚠️ CAUTION: NEVER modify CERTIFY_DID or replace local.p12 once credentials have
# been issued. Doing so permanently breaks and invalidates all existing student credentials!
#
# Issuer did:key identifier. Extract from running Certify via:
#   curl -sf https://<issuer-domain>/.well-known/did.json | jq -r '"did:key:" + .verificationMethod[0].publicKeyMultibase'
# Or generate a new keystore + DID via:
#   uv run tools did --generate deploy/<tenant>/private_key/CERTIFY_PKCS12/local.p12
#
# (e.g. for deploy/ait: did:key:z6MkhsC1EojKdBoLzPY2kL2mFLSMJbQVC83M2CsnYGwghcsE):
CERTIFY_DID=did:key:z6MkpPLACEHOLDERreplaceMeViaBootstrapDidRefreshScript1
# Keystore Type (PKCS12 for local/test, PKCS11 for production hardware HSM)
KEYSTORE_TYPE=PKCS12
KEYSTORE_PASS=local

# ------------------------------------------------------------------------------
# 3. Upstream Data Source (Adapter / SIS API)
# ------------------------------------------------------------------------------
# Local mock SIS adapter via Traefik domain ingress:
CERTIFY_RECORD_URL=http://adapter.localhost/student/{sub}/transcript
# Dev (NetBird VPN): http://ait-itserv-dev-vm.netbird.selfhosted:8000/student/{sub}/transcript
# UAT (NetBird VPN): http://ait-itserv-uat-vm.netbird.selfhosted:8000/student/{sub}/transcript

# ------------------------------------------------------------------------------
# 4. Approval Gate (Policy Checklist)
# ------------------------------------------------------------------------------
MOSIP_CERTIFY_GATEWAY_ENABLED=false
MOSIP_CERTIFY_GATEWAY_URL=NO GATEWAY

# ------------------------------------------------------------------------------
# 5. Authorization Server (OAuth2 / OIDC Token Verification)
# ------------------------------------------------------------------------------
# Point to Certify JWKS for standalone/pre-authorized issuance, or Keycloak/campus OAuth:
AUTH_SERVER_JWKS_URL=http://service:8090/v1/certify/.well-known/jwks.json
AUTH_SERVER_ISSUER=https://oauth-dev.ait-itserv.dpi.ait.ac.th/realms/ait-dev
AUTH_SERVER_WALLET_CLIENT_ID=wallet-demo
# AUTH_SERVER_TOKEN_ENDPOINT=https://oauth-dev.ait-itserv.dpi.ait.ac.th/realms/ait-dev/protocol/openid-connect/token
# AUTH_SERVER_PUBLIC_URL=https://oauth-dev.ait-itserv.dpi.ait.ac.th/realms/ait-dev

# ------------------------------------------------------------------------------
# 6. Inji Verify Configuration
# ------------------------------------------------------------------------------
VERIFIER_TITLE=AIT Credential Verifier
INJI_VERIFY_PUBLIC_BASE_URL=http://verifier.localhost
INJI_VERIFY_DID_URI=did:web:localhost%3A9095:v1:verify
INJI_VERIFY_DID_PUBLIC_KEY_URI=did:web:localhost%3A9095:v1:verify#key-0
INJI_VERIFY_REDIRECT_URI=http://verifier.localhost

# ------------------------------------------------------------------------------
# 7. Local Mock Services (compose.mock.yaml)
# ------------------------------------------------------------------------------
KEYCLOAK_PORT=8080
KEYCLOAK_DOCKER_AUTH_SERVER=http://auth.localhost
KEYCLOAK_INTERNAL_BASE_URL=http://auth.localhost
TRAEFIK_AUTH_RULE=Host(`auth.localhost`)
TRAEFIK_PORTAL_RULE=Host(`portal.localhost`)
TRAEFIK_GATEWAY_RULE=Host(`gateway.localhost`)
TRAEFIK_ADAPTER_RULE=Host(`adapter.localhost`)

# ------------------------------------------------------------------------------
# 8. Internal Database (Certify Ledger & Keystore)
# ------------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
