FROM ghcr.io/astral-sh/uv:python3.11-alpine

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1

# Copy root pyproject, lockfile, and README
COPY pyproject.toml uv.lock* README.md /app/

# Copy application source code and mock fixtures
COPY src/ /app/src/
COPY tests/fixtures/ /app/tests/fixtures/
COPY mock/adapter/ /app/mock/adapter/

# Synchronize dependencies and install project scripts
RUN uv sync --no-dev

ENV PYTHONPATH="/app/src/vc-lab:/app/src:/app/mock/adapter" \
    PORT=4200 \
    HOST=0.0.0.0 \
    CREDENTIALS_DIR=/app/credentials \
    CONTEXTS_DIR=/app/vdr/contexts \
    ASSETS_DIR=/app/vdr/assets \
    TEMPLATES_DIR=/app/vdr/templates \
    BASE_TEMPLATES_DIR=/app/base_templates \
    STUDENTS_FILE=/app/tests/fixtures/students.json

EXPOSE 4200

CMD ["uv", "run", "python", "src/vc-lab/main.py"]

