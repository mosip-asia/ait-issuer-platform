{
  "id": "ait",
  "realm": "ait",
  "displayName": "Asian Institute of Technology (AIT)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": true,
  "accessTokenLifespan": 900,
  "browserFlow": "browser-no-sso",
  "authenticationFlows": [
    {
      "alias": "browser-no-sso",
      "description": "Browser flow minus the Cookie/SSO step, so each per-degree Keycloak identity always re-prompts instead of silently reusing a session.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "DISABLED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "ait_transcript_vc_ldp",
      "description": "OpenID4VCI scope for the AIT Transcript credential",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-certify",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "http://certify-nginx/v1/certify/issuance/credential",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "ait",
      "description": "AIT campus LDAP attributes: sub (username/student ID), uid_number and gid_number",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "ait-uid-number",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "uidNumber",
            "claim.name": "uid_number",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "ait-gid-number",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "gidNumber",
            "claim.name": "gid_number",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "ait-transcript-local",
      "name": "AIT transcript, developer laptop (local Inji stack)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://wallet.localhost/redirect",
        "http://wallet.lan/redirect",
        "https://wallet.dpi.ait.ac.th/redirect",
        "http://localhost:4004/redirect",
        "io.mosip.residentapp.inji://oauthredirect",
        "*"
      ],
      "webOrigins": [
        "+",
        "http://wallet.localhost",
        "http://wallet.lan",
        "https://wallet.dpi.ait.ac.th",
        "http://portal.localhost",
        "http://portal.lan",
        "*"
      ],
      "attributes": {
        "jwt.credential.certificate": "",
        "token.endpoint.auth.signing.alg": "RS256",
        "use.jwks.url": "false",
        "use.refresh.tokens": "true",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "ait"
      ],
      "optionalClientScopes": [
        "offline_access",
        "microprofile-jwt",
        "ait_transcript_vc_ldp"
      ],
      "protocolMappers": [
        {
          "name": "sub-from-username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "sub",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-self",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ait-transcript-local",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "client_id-hardcoded",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "client_id",
            "claim.value": "ait-transcript-local",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "c_nonce-hardcoded",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "c_nonce",
            "claim.value": "local-cnonce",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "access.tokenResponse.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "c_nonce_expires_in-hardcoded",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "c_nonce_expires_in",
            "claim.value": "86400",
            "jsonType.label": "long",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "access.tokenResponse.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
