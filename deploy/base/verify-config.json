              }
            },
            "constraints": {
              "fields": [
                {
                  "path": ["$.type"],
                  "filter": {
                    "type": "object",
                    "pattern": "StudentIdCredential|AitIdCredential|AitStudentIdCredential"
                  }
                }
              ]
            }
