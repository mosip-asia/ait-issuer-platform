{
  "verifiableClaims": [
    {
      "logo": "/assets/cert.png",
      "name": "AIT Transcript",
      "type": "AitTranscriptCredential",
      "clientIdScheme": "did",
      "definition": {
        "purpose": "Verify the holder's AIT academic transcript credential.",
        "format": {
          "ldp_vc": {
            "proof_type": ["Ed25519Signature2020"]
          }
        },
        "input_descriptors": [
          {
            "id": "ait transcript credential",
            "format": {
              "ldp_vc": {
                "proof_type": ["Ed25519Signature2020"]
              }
            },
            "constraints": {
              "fields": [
                {
                  "path": ["$.type"],
                  "filter": {
                    "type": "object",
                    "pattern": "AitTranscriptCredential"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "logo": "/assets/cert.png",
